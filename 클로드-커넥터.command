#!/bin/bash
# S1 UX Writing - 클로드 커넥터 one-shot installer for macOS (generated by npm run build - do not edit)
# 실행: 받은 파일을 우클릭 → [열기] (처음 열면 "확인되지 않은 개발자" 경고 — Gatekeeper 때문).
# 설치·점검이 끝나면 터미널은 스스로 닫히고, claude 설치·로그인 안내는 피그마 플러그인이 보여준다.
B64_BRIDGE=''
B64_WATCHER=''
B64_EXAMPLES=''
B64_GUIDE=''
DIR="$HOME/Library/Application Support/ClaudeBridge"
put() { printf %s "$1" | base64 -D > "$2"; }
# 이 .command가 도는 터미널 창만 골라 닫는다(tty 매칭). bash가 끝나 탭이 idle된 1초 뒤에 닫아
# "프로세스 실행 중" 경고를 피한다 — disown으로 스크립트가 exit해도 닫기 작업은 살아남는다. (맥 실기 검증 필요)
MYTTY="$(ps -o tty= -p $$ 2>/dev/null | tr -d " ")"
close_terminal() {
  [ -z "$MYTTY" ] && return
  ( sleep 1
    /usr/bin/osascript >/dev/null 2>&1 <<OSA
tell application "Terminal"
  repeat with w in windows
    try
      repeat with t in tabs of w
        if tty of t is "/dev/$MYTTY" then close w saving no
      end repeat
    end try
  end repeat
end tell
OSA
  ) & disown 2>/dev/null || true
}
# 안내는 플러그인이 보여준다 — 터미널은 설치·점검만 하고 스스로 닫힌다.
finish() { close_terminal; exit "$1"; }
echo "클로드 커넥터를 설치하고 있어요… 잠시 후 이 창은 자동으로 닫혀요."
mkdir -p "$DIR/scripts" || { echo "폴더 생성 실패: $DIR"; finish 1; }
put "$B64_BRIDGE"   "$DIR/scripts/claude-bridge.js"
put "$B64_WATCHER"  "$DIR/scripts/bridge-watcher.js"
put "$B64_EXAMPLES" "$DIR/recommend-examples.md"
put "$B64_GUIDE"    "$DIR/ux-writing.md"
echo "✅ 파일 설치: $DIR"
# GUI에서 연 Terminal은 PATH가 좁을 수 있어 흔한 설치 경로를 보탠다
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# node가 없으면 감시자(=node) 자체가 못 돌아 플러그인에 알릴 방법이 없다 → 이 경우만 네이티브 팝업으로 안내한다
if ! command -v node >/dev/null 2>&1; then
  osascript -e 'display dialog "이 Mac에 Node.js가 없어요. [확인]을 누르면 다운로드 페이지가 열려요. Node.js(LTS)를 설치한 뒤 이 설치 파일을 다시 실행해 주세요." with title "클로드 커넥터 — Node.js 필요" buttons {"확인"} default button 1 with icon caution giving up after 180' >/dev/null 2>&1
  open "https://nodejs.org/ko/download" 2>/dev/null
  finish 0
fi
NODE_BIN="$(command -v node)"
echo "✅ Node.js: $(node --version)"
# 감시자 launchd 등록 (로그인 자동시작 + 지금 기동). PATH를 plist에 굳혀 넣는다 — launchd 기본 PATH엔 claude가 없다.
PLIST="$HOME/Library/LaunchAgents/com.claudebridge.watcher.plist"
mkdir -p "$HOME/Library/LaunchAgents"
SAFE_PATH="${PATH//&/&amp;}"
cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.claudebridge.watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>$NODE_BIN</string>
    <string>$DIR/scripts/bridge-watcher.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>$SAFE_PATH</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
</dict>
</plist>
PLISTEOF
launchctl bootout "gui/$(id -u)/com.claudebridge.watcher" 2>/dev/null
launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null
# claude 유무·로그인 여부는 여기서 알리지 않는다 — 감시자가 그 상태를 플러그인에 전달해
# 계정 화면이 "설치 필요 / 로그인 필요 / 준비 완료"로 노출한다(터미널이 채널이 아님).
# 설치·점검 끝 → 창을 스스로 닫는다.
finish 0
